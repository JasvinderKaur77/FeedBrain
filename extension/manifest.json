{
  "manifest_version": 3,
  "name": "FeedBrain",
  "version": "1.0.0",
  "description": "Save anything, forget nothing. Your second memory.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open FeedBrain"
  }
}